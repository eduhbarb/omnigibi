# Copie para .env e ajuste conforme necessario.
# Banco de dados (SQLite por padrao)
DATABASE_URL=

# Fontes habilitadas (separadas por virgula).
# Opcoes: mercadolivre, amazon, panini, comix
# A fonte 'panini' exige o pacote curl_cffi (ja incluido em requirements.txt).
ENABLED_SOURCES=mercadolivre,amazon,panini

# Timeout das requisicoes HTTP (segundos)
HTTP_TIMEOUT=12

# Maximo de ofertas coletadas por fonte em cada busca
MAX_RESULTS_PER_SOURCE=12

# User-Agent dos coletores (deixe vazio para o padrao de navegador)
USER_AGENT=

# Atualizacao automatica de precos
SCHEDULER_ENABLED=true
SCRAPE_INTERVAL_MINUTES=30

# Popula a banca com classicos na primeira execucao
SEED_DEMO_DATA=true
